#!/usr/bin/env python

import os
import sys

import yaml

if len(sys.argv) != 2:
    print(f"Usage: {sys.argv[0]} /path/to/firefox")
    sys.exit(1)

template = os.path.join(
    os.path.dirname(__file__),
    "../sql_generators/use_counters/templates/templating.yaml",
)
firefox_checkout = sys.argv[1]

with open(f"{firefox_checkout}/dom/base/use_counter_metrics.yaml") as f:
    data = yaml.safe_load(f)

all_denominators = set()
all_counters = set()

with open(template) as f:
    existing_data = yaml.safe_load(f)
    for denom in existing_data["use_counter_denominators"]:
        all_denominators.add(denom["name"])
    for counter in existing_data["use_counters"]:
        all_counters.add(counter["name"])

for k in data:
    if not k.startswith("use.counter"):
        continue
    prefix = k.replace(".", "_") + "_"
    entries = [prefix + key.replace("__", "_") for key in data[k]]
    if k == "use.counter":
        all_denominators.update(entries)
    else:
        all_counters.update(entries)

result = {
    "use_counter_denominators": [{"name": name} for name in sorted(all_denominators)],
    "use_counters": [{"name": name} for name in sorted(all_counters)],
}

with open(template, "w") as f:
    yaml.dump(result, f)
